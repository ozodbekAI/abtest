+    @classmethod
+    def _image_relation(cls, data1: bytes, data2: bytes) -> tuple[str, int | None]:
+        """Classify two images: identical | indistinguishable | similar | distinct.
+
+        Only identical/indistinguishable are technical blockers. "similar" is a
+        policy warning and never forbids an experiment by itself.
+        """
+        if data1 == data2:
+            return "identical", 0
+        try:
+            distance = cls._image_hash_distance(cls._perceptual_hash(data1), cls._perceptual_hash(data2))
+        except (ValueError, OSError):
+            return "distinct", None
+        if distance < cls.IMAGE_MIN_DISTINGUISHABLE_DISTANCE:
+            return "indistinguishable", distance
+        if distance <= cls.IMAGE_PHASH_THRESHOLD:
+            return "similar", distance
+        return "distinct", distance
+
