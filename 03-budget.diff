@@ -67,3 +67,24 @@ def calculate_protected_budget(
     reserve = max(int(safety_reserve_rub or 0), 0)
     protected = base + reserve
     return ((protected + BUDGET_STEP_RUB - 1) // BUDGET_STEP_RUB) * BUDGET_STEP_RUB
+
+
+def validate_budget_ceiling(amount_rub: int | float, max_budget_rub: int, *, provider_int_max: int = 2_147_483_647) -> int:
+    """Validate a single server-side funding ceiling before any provider mutation.
+
+    This is intentionally a pure function so start/resume and tests can share the
+    exact same guard. A provider-side balance is never treated as permission to
+    exceed the application ceiling.
+    """
+    try:
+        amount = int(amount_rub)
+        ceiling = int(max_budget_rub)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError("Некорректный бюджет") from exc
+    if amount < 0:
+        raise ValueError("Бюджет не может быть отрицательным")
+    if ceiling <= 0:
+        raise ValueError("Лимит бюджета должен быть положительным")
+    if amount > ceiling or amount > provider_int_max:
+        raise ValueError(f"Бюджет {amount} ₽ превышает безопасный лимит {min(ceiling, provider_int_max)} ₽")
+    return amount
